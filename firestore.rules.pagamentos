// ==========================================================
// NexaMatch — regras NOVAS para mensagem paga, saldo e fotos
//
// COMO USAR: no Firebase Console > Firestore > Regras, cole os blocos
// "match /wallets" e "match /chats" DENTRO do seu
//     match /databases/{database}/documents { ... }
// que já existe (junto com as regras de users, accounts, likes e matches).
//
// IMPORTANTE:
//  1) Se a sua regra de  matches/{id}/messages  limita os campos permitidos
//     (por exemplo hasOnly(['from','text','createdAt'])), inclua também 'image'
//     (string com menos de 700000 caracteres) e, em matches/{id}.lastMessage, 'image'.
//  2) O bloco "wallets" abaixo deixa o próprio usuário ADICIONAR saldo de TESTE.
//     Antes de cobrar dinheiro de verdade, REMOVA essa permissão e passe a
//     creditar o saldo só pelo servidor (Cloud Function) depois de o pagamento
//     (Pix, cartão...) ser confirmado. Senão qualquer pessoa gera saldo grátis.
//  3) Estas regras ainda não foram testadas no emulador do Firebase: teste
//     antes de publicar.
// ==========================================================

    // ----- Saldo do homem -----
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // criar ou alterar: só o dono, saldo inteiro e nunca negativo
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.balanceCents is int
        && request.resource.data.balanceCents >= 0
        && (
          // gastar com mensagens (o saldo só diminui)
          (resource != null && request.resource.data.balanceCents <= resource.data.balanceCents)
          // >>> SALDO DE TESTE: apague as 2 linhas abaixo ao ligar o pagamento real <<<
          || (resource == null && request.resource.data.balanceCents <= 5000)
          || (resource != null && request.resource.data.balanceCents - resource.data.balanceCents <= 5000)
        );

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ----- Conversas sem match (homem <-> mulher) -----
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;

      // criada na primeira mensagem, por um dos dois, entre um homem e uma mulher
      allow create: if request.auth != null
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && chatId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.manId in request.resource.data.users
        && request.resource.data.womanId in request.resource.data.users
        && get(/databases/$(database)/documents/users/$(request.resource.data.manId)).data.gender == 'homem'
        && get(/databases/$(database)/documents/users/$(request.resource.data.womanId)).data.gender == 'mulher'
        // mulher só abre conversa com quem ela curtiu
        && (request.auth.uid == request.resource.data.manId
            || exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + request.resource.data.manId)));

      // atualizar: os dois mexem em "não lidas" e "última mensagem"; os ganhos só
      // sobem pelo preço de UMA mensagem, e só quando o saldo do homem desce o mesmo
      allow update: if request.auth != null && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users
        && request.resource.data.manId == resource.data.manId
        && request.resource.data.womanId == resource.data.womanId
        && (request.resource.data.earnedCents - resource.data.earnedCents) in [0, 200]
        && (request.resource.data.earnedCents == resource.data.earnedCents
            || getAfter(/databases/$(database)/documents/wallets/$(resource.data.manId)).data.balanceCents
               == get(/databases/$(database)/documents/wallets/$(resource.data.manId)).data.balanceCents - 200);

      allow delete: if request.auth != null && request.auth.uid in resource.data.users;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;

        // getAfter: a conversa pode ser criada na mesma transação da primeira mensagem
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.users
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && (!('image' in request.resource.data)
              || (request.resource.data.image is string && request.resource.data.image.size() < 700000))
          // preço: só o homem paga, e só se ela ainda não o curtiu (nem houve match)
          && request.resource.data.priceCents == (
              (request.auth.uid == getAfter(/databases/$(database)/documents/chats/$(chatId)).data.manId
               && !exists(/databases/$(database)/documents/likes/$(getAfter(/databases/$(database)/documents/chats/$(chatId)).data.womanId + '_' + request.auth.uid)))
              ? 200 : 0);

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
